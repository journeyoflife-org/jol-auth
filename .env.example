# =============================================================================
# JOL Auth — Environment Configuration
# =============================================================================
# Copy this file to .env and populate the values before running the service.
# NEVER commit .env to version control.
#
# All secrets MUST be generated — do NOT use the placeholder values below.
# Generate a Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Generate a secret key:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# =============================================================================

# --- Application ---
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=            # REQUIRED: generate with secrets.token_urlsafe(48)
APP_HOST=0.0.0.0
APP_PORT=8000

# --- Database ---
# Replace <password> with your actual database password
DATABASE_URL=postgresql+asyncpg://jol_identity_user:<PASSWORD>@localhost:5432/jol_identity
POSTGRES_USER=jol_identity_user
POSTGRES_PASSWORD=         # REQUIRED: set your database password
POSTGRES_DB=jol_identity

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- JWT / OIDC ---
JWT_ISSUER=https://auth.journeyoflife.org
JWT_AUDIENCE=https://api.journeyoflife.org
JWT_SIGNING_ALGORITHM=RS256
JWKS_KID=
JWKS_PRIVATE_KEY_PATH=
JWKS_PUBLIC_KEY_PATH=

# --- OAuth 2.0 ---
OAUTH_AUTHORIZATION_CODE_TTL=300
OAUTH_ACCESS_TOKEN_TTL=900
OAUTH_REFRESH_TOKEN_TTL=2592000
OAUTH_REFRESH_ROTATION=true

# --- Session ---
SESSION_IDLE_TIMEOUT=1800
SESSION_ABSOLUTE_TIMEOUT=86400
SESSION_COOKIE_NAME=jol_session
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax

# --- MFA ---
MFA_TOTP_ISSUER=JourneyOfLife
MFA_TOTP_DIGITS=6
MFA_TOTP_PERIOD=30
MFA_ENCRYPTION_KEY=       # REQUIRED: generate with Fernet.generate_key()

# --- Rate Limiting ---
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_LOGIN_ATTEMPTS=5
RATE_LIMIT_TOKEN_PER_MINUTE=30
RATE_LIMIT_MFA_ATTEMPTS=10

# --- Telemetry ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=jol-auth
LOG_LEVEL=INFO

# --- CORS ---
CORS_ORIGINS=http://localhost:3000
